{
  "name": "@smartstack/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: serves the web app, /api/*, and the every-minute reminder cron",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --var ACCOUNTS_MODE:public --var APP_ORIGIN:http://localhost:5173 --var EMAIL_MODE:log",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply smartstack --local",
    "db:migrate:remote": "wrangler d1 migrations apply smartstack --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply smartstack-staging --env staging --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@smartstack/shared": "*",
    "arctic": "^3.7.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "wrangler": "^4.138.0"
  }
}
