# Committed on purpose: nothing in this file is secret.
# VITE_VAPID_PUBLIC_KEY — the PUBLIC half of the pair from `npx web-push generate-vapid-keys`.
#   The private half goes in apps/worker/.dev.vars (local) and `wrangler secret put` (prod).
VITE_VAPID_PUBLIC_KEY=BProg2B-2MpQYotwZwsJOIHc_rTVBisevREVnVVZ0bPc5MggyMDxvjeVR45kW9RHKHuzKNcRzUA3-ejU3ZWWWbY
# VITE_BETA_KEY — sent as X-Beta-Key on PUT /api/me. A speed bump, not security.
#   Must match BETA_KEY in apps/worker/wrangler.toml.
VITE_BETA_KEY=qEjK2x-cvUwSsn4qF-1RsKhd
